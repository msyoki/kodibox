{
  "name": "@kodibox/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "purge:expired": "tsx --env-file-if-exists=../../.env src/scripts/purge-expired.ts",
    "seed:demo": "tsx --env-file-if-exists=../../.env src/scripts/seed-demo.ts"
  },
  "dependencies": {
    "@kodibox/config": "workspace:*",
    "@kodibox/core": "workspace:*",
    "@kodibox/db": "workspace:*",
    "@kodibox/integrations": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "better-auth": "1.7.25",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "postgres": "^4.0.0",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
