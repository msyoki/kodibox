# Copy to .env and adjust. Dummy values only; never commit real secrets.

NODE_ENV=development
APP_URL=http://localhost:3000

# Postgres (docker-compose.yml: postgres)
POSTGRES_PASSWORD=change-me-local-only
# Host port for Postgres (change if 5432 is taken or reserved, e.g. on Windows)
POSTGRES_PORT=5432
DATABASE_URL=postgres://kodibox:change-me-local-only@127.0.0.1:5432/kodibox

# Redis (docker-compose.yml: redis)
REDIS_URL=redis://127.0.0.1:6379

# Auth: at least 32 characters. Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-change-me-change-me-change-me
# Placeholder key-encryption key for envelope encryption (real KMS-backed key later)
ENCRYPTION_KEK=change-me-kek-placeholder

# Mailpit (local SMTP catcher; UI at http://127.0.0.1:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# MinIO (S3-compatible; console at http://127.0.0.1:9001)
MINIO_ROOT_USER=kodibox
MINIO_ROOT_PASSWORD=change-me-local-only
S3_ENDPOINT=http://127.0.0.1:9000

# M-Pesa Daraja (sandbox) - optional until M1-06
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
DARAJA_SHORTCODE=

# Africa's Talking (sandbox) - optional until notifications
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
