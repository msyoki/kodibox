# Copy to .env and adjust. Dummy values only; never commit real secrets.

NODE_ENV=development
# Web dev server runs on 3100 locally (3000 is often taken); code reads the port from these vars.
APP_URL=http://localhost:3100

# Postgres (docker-compose.yml: postgres)
POSTGRES_PASSWORD=change-me-local-only
# Host port for Postgres (change if 5432 is taken or reserved, e.g. on Windows)
POSTGRES_PORT=5433
# Superuser used by docker-compose to create the DB; used ONLY by `pnpm db:bootstrap` (DATABASE_ADMIN_URL).
DATABASE_ADMIN_URL=postgres://kodibox:change-me-local-only@127.0.0.1:5433/kodibox
# Passwords for the two least-privilege roles that db:bootstrap creates
KODIBOX_MIGRATOR_PASSWORD=change-me-migrator-local-only
KODIBOX_APP_PASSWORD=change-me-app-local-only
KODIBOX_AUTH_PASSWORD=change-me-auth-local-only
# Migrations (pnpm db:migrate): role kodibox_migrator, owns the schema. Never set at runtime.
MIGRATION_DATABASE_URL=postgres://kodibox_migrator:change-me-migrator-local-only@127.0.0.1:5433/kodibox
# Explicit opt-in for `pnpm db:seed` (demo data; dev/test only, never set in production)
ALLOW_DB_SEED=1
# Runtime (web, worker, seed): role kodibox_app, no BYPASSRLS, not table owner
DATABASE_URL=postgres://kodibox_app:change-me-app-local-only@127.0.0.1:5433/kodibox

# Auth server (Better Auth): role kodibox_auth, the ONLY role that can read credential tables
# (password hashes, TOTP secrets, sessions). Separate from DATABASE_URL on purpose.
AUTH_DATABASE_URL=postgres://kodibox_auth:change-me-auth-local-only@127.0.0.1:5433/kodibox

# Redis (docker-compose.yml: redis)
REDIS_URL=redis://127.0.0.1:6379

# Auth: at least 32 characters. Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-change-me-change-me-change-me
# Public auth base URL (defaults to APP_URL) and extra trusted origins (comma-separated, optional)
BETTER_AUTH_URL=http://localhost:3100
# AUTH_TRUSTED_ORIGINS=
# Number of trusted reverse proxies in front of the app. The client IP is the Nth entry from the RIGHT
# of X-Forwarded-For. 0 = trust no forwarded header (all clients share one rate-limit bucket).
# REQUIRED in production.
TRUSTED_PROXY_HOPS=0
# Public self-service sign-up stays closed until onboarding exists. Set 1 to open it (dev only).
# AUTH_PUBLIC_SIGNUP=0
# Production refuses to start auth while phone/email are plaintext at rest (E-06 deploy blocker).
# Staging-only override, documented in docs/SECURITY.md:
# AUTH_ALLOW_PLAINTEXT_PII=1
# Breached-password (HIBP k-anonymity) check: on in production, set 1 to force it on elsewhere
# AUTH_BREACHED_PASSWORD_CHECK=0
# Dev seed users (pnpm db:seed): one throwaway password for all demo accounts, 12+ chars, dev only
SEED_DEMO_PASSWORD=dev-only-demo-password-1
# Placeholder key-encryption key for envelope encryption (real KMS-backed key later)
ENCRYPTION_KEK=change-me-kek-placeholder

# Mailpit (local SMTP catcher; UI at http://127.0.0.1:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# MinIO (S3-compatible; console at http://127.0.0.1:9001)
MINIO_ROOT_USER=kodibox
MINIO_ROOT_PASSWORD=change-me-local-only
S3_ENDPOINT=http://127.0.0.1:9000

# Africa's Talking (sandbox) - optional until notifications
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
