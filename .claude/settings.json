{
  "permissions": {
    "allow": [
      "Read", "Grep", "Glob",
      "Bash(pnpm lint:*)", "Bash(pnpm typecheck:*)", "Bash(pnpm test:*)", "Bash(pnpm build:*)",
      "Bash(pnpm db:migrate:*)", "Bash(pnpm db:generate:*)", "Bash(pnpm install:*)",
      "Bash(pnpm --filter:*)", "Bash(pnpm turbo:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)", "Bash(git branch:*)",
      "Read(./.env.example)"
    ],
    "deny": [
      "Read(./.env)", "Read(./.env.local)", "Read(./.env.development)", "Read(./.env.production)",
      "Read(./.env.test)", "Read(./.env.staging)", "Read(./.env.*.local)",
      "Read(**/secrets/**)", "Read(**/*.pem)", "Read(**/*.key)",
      "Edit(./.env)", "Edit(./.env.local)", "Edit(./.env.production)",
      "Bash(rm -rf:*)", "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git reset --hard:*)",
      "Bash(curl:*)", "Bash(wget:*)",
      "Bash(cat .env:*)", "Bash(cat ./.env:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"" }
        ]
      }
    ]
  }
}
